{
  "name": "gatePass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun dev.ts",
    "app:dev": "bun --hot app.tsx",
    "server:dev": "bun --watch server/index.ts",
    "build": "bun build --compile app.tsx --outfile dist/gatePass",
    "web:dev": "bun web.ts",
    "screenshot": "bun screenshot.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gpuix/react": "^0.8.0",
    "@tanstack/react-query": "^5.102.8",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-error-boundary": "^6.1.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
